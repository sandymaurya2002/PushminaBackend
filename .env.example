# ---------------------------------------------------------------------------
# Pushmina Backend — environment configuration
# Copy this file to `.env` and fill in the values for your local machine.
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Public base URL of THIS api, used to build absolute media URLs in responses.
API_BASE_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# Local: both URLs can point at the same local server.
# Supabase (IPv4): DATABASE_URL = transaction pooler :6543
#                  DIRECT_URL    = session pooler :5432 (migrate / seed)
# If the password contains @ : / ? # [ ] it must be percent-encoded.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/pushmina_db?schema=public
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/pushmina_db?schema=public

# Supabase example (replace PROJECT, PASSWORD, REGION):
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Authentication
# Generate strong values:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# CORS — comma separated list of allowed browser origins.
# 3000 = Next.js storefront, 5173 = Vite admin panel.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Storefront origin, used in emails, invoices and payment redirect URLs.
# ---------------------------------------------------------------------------
STOREFRONT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Media storage. driver = local | s3 | cloudinary   (only `local` is wired up)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Payments — Razorpay
# Leave RAZORPAY_KEY_ID empty to run in MOCK mode: the full order/payment/
# refund lifecycle works locally without real credentials or internet access.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email. Leave SMTP_HOST empty to log emails to the console instead of sending.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Pushmina <care@pushmina.com>"

# ---------------------------------------------------------------------------
# Commerce rules (mirrors the storefront's src/lib/site.ts defaults; the
# authoritative values live in the site_settings table once seeded).
# ---------------------------------------------------------------------------
FREE_SHIPPING_THRESHOLD=4999
STANDARD_SHIPPING_FEE=149
EXPRESS_SHIPPING_FEE=399
GST_RATE=0.05
COD_LIMIT=20000

# ---------------------------------------------------------------------------
# First admin account, created by `npm run db:seed`.
# Change the password immediately after first login.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@pushmina.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Pushmina Administrator

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=debug
