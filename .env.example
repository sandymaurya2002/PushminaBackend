# ---------------------------------------------------------------------------
# Pashmore gateway (optional). A stateless proxy in front of the Cloudflare
# Worker API: it has no database, sessions or business logic. Deploy it only
# if clients must keep calling the old Render/Azure hostname; otherwise point
# them straight at the Worker.
# Copy to `.env` for local use. `.env` is git-ignored.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Worker origin (https; http only for localhost, e.g. `wrangler dev` on :8787).
WORKER_API_URL=http://localhost:8787

# Must equal the Worker secret of the same name (`wrangler secret put GATEWAY_SECRET`).
# At least 32 characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_SECRET=

# Reverse-proxy hops in front of this process (Render and Azure: 1).
TRUST_PROXY_HOPS=1
UPSTREAM_TIMEOUT_MS=30000
MAX_BODY_MB=25
