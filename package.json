{
  "name": "pushmina-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Pashmore: stateless Node gateway in front of the Cloudflare Worker API (worker/), plus the admin dashboard (admin/).",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/gateway.test.ts",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "worker:dev": "npm --prefix worker run dev",
    "worker:test": "npm --prefix worker test"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
