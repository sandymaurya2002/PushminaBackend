<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service on Windows hosts Node through IIS.
  Without this file IIS serves the site folder as a static directory,
  finds no index page, and returns 403 "You do not have permission to view this directory or page."
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="DynamicContent" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <iisnode loggingEnabled="true" devErrorsEnabled="false" debuggingEnabled="false" nodeProcessCommandLine="node" />
  </system.webServer>
</configuration>
