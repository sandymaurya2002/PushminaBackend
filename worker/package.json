{
  "name": "pashmore-api",
  "version": "1.0.0",
  "private": true,
  "description": "Pashmore commerce API on Cloudflare Workers, backed by D1 (pashmore-db) and R2 (pashmore-media).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrations:list": "wrangler d1 migrations list DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:schema:check": "node scripts/check-remote-schema.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "seed:catalog": "node scripts/seed-catalog.mjs",
    "seed:content": "node scripts/seed-content.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261013.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
